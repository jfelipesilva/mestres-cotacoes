# Regra sudoers para o disparo do cotador (OpenClaw) pelo scheduler do Laravel.
#
# Instalar no servidor como /etc/sudoers.d/cotador-cotacoes (root:root, 0440):
#   sudo install -m 0440 -o root -g root deploy/sudoers-cotador /etc/sudoers.d/cotador-cotacoes
#   sudo visudo -cf /etc/sudoers.d/cotador-cotacoes   # valida a sintaxe
#
# Permite ao usuário "deploy" executar APENAS o wrapper fixo, como root, sem senha.
# Sem wildcard: o deploy não controla nenhum argumento — princípio do menor privilégio.
#
# Ver: docs/integracao-cotador-openclaw.md

deploy ALL=(root) NOPASSWD: /usr/local/bin/disparar-cotador
